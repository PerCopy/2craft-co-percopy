{
  "dependencies": [
    {
      "name": "postgres",
      "kind": "database",
      "provisioner": "testcontainers",
      "image": "postgres:16",
      "canonical_port": 5432,
      "toxiproxy_listen_port": 5432,
      "upstream": "postgres:5432",
      "runtime_value": "postgresql://app:app@toxiproxy:5432/appdb",
      "env_var": "DATABASE_URL"
    },
    {
      "name": "resend",
      "kind": "http_api",
      "provisioner": "none",
      "reason": "Resend SDK no-ops when RESEND_API_KEY is unset; constructor accepts no base-URL seam"
    }
  ],
  "service_port": 6713,
  "health_check_path": "/health",
  "api_base_path": "/",
  "api_probe_path": "/health"
}
